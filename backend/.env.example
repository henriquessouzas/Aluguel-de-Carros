# ── Como obter a connection string no Supabase ────────────────────────────────
# 1. Acesse https://supabase.com e abra seu projeto.
# 2. Vá em Project Settings → Database → Connection string.
# 3. Selecione o modo "JDBC" e copie a URL (formato jdbc:postgresql://...).
# 4. O usuário padrão é "postgres" e a senha é a definida na criação do projeto.
# 5. Cole os valores abaixo e renomeie este arquivo para .env.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_password

# Gere um segredo forte (ex: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_here
